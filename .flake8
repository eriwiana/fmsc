[flake8]
ignore = D203, E501, W503, E203
exclude =
    # No need to traverse our git directory
    .git,
    # There's no value in checking cache directories
    __pycache__,
    # The conf file is mostly autogenerated, ignore it
    docs/source/conf.py,
    # The old directory contains Flake8 2.0
    old,
    # This contains our built documentation
    build,
    # This contains builds of flake8 that we don't want to check
    dist,
    # Alembic autogenerates these; black formats them, flake8 would only fight it
    alembic/versions
max-complexity = 10
max-line-length = 100
# timedelta and similar are immutable, so calling them in a default is safe (B008).
extend-immutable-calls = datetime.timedelta, timedelta
